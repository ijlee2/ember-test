{
  "name": "ember-testem",
  "version": "0.5.3",
  "description": "Backward- and forward-compatible testing for Ember projects",
  "keywords": [
    "ci",
    "ember",
    "emberjs",
    "testem",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/ember-testem.git",
    "directory": "packages/ember-testem"
  },
  "license": "MIT",
  "author": "Isaac J. Lee",
  "type": "module",
  "main": "dist/src/run.js",
  "bin": {
    "ember-test": "dist/bin/ember-test.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "sh build.sh --production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "prepare": "pnpm build",
    "test": "sh build.sh --test && mt dist-for-testing --quiet",
    "update-test-fixtures": "./update-test-fixtures.sh"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "testem": "^4.0.0-beta.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@codemod-utils/tests": "^3.3.1",
    "@shared-configs/eslint-config-node": "workspace:*",
    "@shared-configs/prettier": "workspace:*",
    "@shared-configs/typescript": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/sinon": "^22.0.2",
    "@types/yargs": "^17.0.35",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.22.0 || >= 24"
  }
}
