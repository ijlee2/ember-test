    "start": "rollup --config --watch",
    "test": "pnpm build:test && ember-test"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.3",
    "@glimmer/component": "^2.1.1",
    "decorator-transforms": "^2.4.0"
  },
  "devDependencies": {
    "@ember/test-helpers": "^5.7.0",
    "@embroider/macros": "^1.21.4",
    "@embroider/vite": "^1.8.0",
    "@types/qunit": "^2.19.14",
    "concurrently": "^10.0.5",
    "ember-qunit": "^9.2.0",
    "ember-source": "~7.3.0",
    "ember-strict-application-resolver": "^0.1.1",
    "ember-testem": "^0.6.0",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0",
    "rollup": "^4.63.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "ember": {
