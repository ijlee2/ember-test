{
  "name": "my-v2-addon",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "ember-addon"
  ],
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "build:test": "NODE_ENV=development vite build --config vite.test.config.mjs --mode development",
