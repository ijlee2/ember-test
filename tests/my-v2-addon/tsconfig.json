{
  "extends": "@shared-configs/typescript/ember-addon",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@glint/tsserver-plugin"
      }
    ],
    "rootDir": ".",
    "types": [
      "@ember-intl/vite/virtual",
      "@glint/ember-tsc/types",
      "@types/qunit",
      "ember-source/types",
      "vite/client"
    ]
  },
  "include": ["src", "unpublished-development-types", "tests", "*.mts"],
  "glint": {
    "additionalSpecialForms": {
      "globals": {
        "and": "&&",
        "eq": "===",
        "not": "!",
        "neq": "!==",
        "or": "||"
      },
      "imports": {
        "ember-truth-helpers": {
          "and": "&&",
          "eq": "===",
          "not": "!",
          "not-eq": "!==",
          "or": "||"
        },
        "ember-truth-helpers/helpers/and": {
          "default": "&&"
        },
        "ember-truth-helpers/helpers/eq": {
          "default": "==="
        },
        "ember-truth-helpers/helpers/not": {
          "default": "!"
        },
        "ember-truth-helpers/helpers/not-eq": {
          "default": "!=="
        },
        "ember-truth-helpers/helpers/or": {
          "default": "||"
        }
      }
    }
  }
}
