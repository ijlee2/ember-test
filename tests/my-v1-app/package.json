{
  "name": "my-v1-app",
  "version": "0.2.3",
  "private": true,
  "description": "",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/ember-test.git"
  },
  "license": "MIT",
  "author": "Isaac J. Lee",
  "scripts": {
    "build": "ember build --environment production",
    "build:test": "ember build --environment test",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --cache",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:intl": "ember-intl-lint",
    "lint:intl:fix": "ember-intl-lint --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "prelint:types": "type-css-modules --src app",
    "lint:types": "ember-tsc --noEmit",
    "start": "ember serve",
    "test": "pnpm build:test && pnpm test:ember-testem",
    "test:ember-cli": "ember test --path dist --test-port 0",
    "test:ember-testem": "ember-test --port 0",
    "test:ember-testem:filter-by-filter": "ember-test --filter \"integration\" --port 0",
    "test:ember-testem:filter-by-module": "ember-test --module \"Acceptance | form\" --port 0",
    "test:watch": "concurrently \"pnpm build:test --watch\" \"pnpm test:ember-testem --server\" --names build,test"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@ember-intl/lint": "^2.3.3",
    "@ember-intl/v1-compat": "^2.0.5",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.7.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^3.9.4",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^3.5.10",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.21.3",
    "@embroider/router": "^2.1.12",
    "@embroider/webpack": "^4.1.2",
    "@faker-js/faker": "^10.6.0",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@glint/ember-tsc": "^1.11.6",
    "@glint/template": "^1.9.0",
    "@glint/tsserver-plugin": "^2.7.9",
    "@shared-configs/eslint-config-ember": "workspace:*",
    "@shared-configs/prettier": "workspace:*",
    "@shared-configs/stylelint": "workspace:*",
    "@shared-configs/testem": "workspace:*",
    "@shared-configs/typescript": "workspace:*",
    "@types/qunit": "^2.19.14",
    "@types/sinon": "^22.0.0",
    "axe-core": "^4.14.0",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^10.0.6",
    "ember-a11y-refocus": "^5.2.1",
    "ember-a11y-testing": "^8.0.1",
    "ember-auto-import": "^2.13.1",
    "ember-cli": "~6.12.0",
    "ember-cli-app-version": "^7.0.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-mirage": "^3.0.4",
    "ember-concurrency": "^5.3.0",
    "ember-container-query": "^7.1.5",
    "ember-intl": "^9.3.1",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.2.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.12.1",
    "ember-template-imports": "^4.4.0",
    "ember-testem": "workspace:*",
    "ember-truth-helpers": "^5.0.0",
    "embroider-css-modules": "^4.1.4",
    "eslint": "^10.13.0",
    "loader.js": "^4.7.0",
    "miragejs": "^0.1.48",
    "my-v1-addon": "workspace:*",
    "prettier": "^3.9.10",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0",
    "sinon": "^22.1.0",
    "stylelint": "^17.16.0",
    "type-css-modules": "^3.2.12",
    "typescript": "^6.0.3",
    "webpack": "^5.112.0"
  },
  "engines": {
    "node": "22.* || >= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "type": "app",
    "version": 2
  }
}
