{
  "extends": "@shared-configs/typescript/ember-addon",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "paths": {
      "dummy/tests/*": ["./tests/*"],
      "dummy/*": ["./tests/dummy/app/*"],
      "my-v1-addon": ["./addon"],
      "my-v1-addon/*": ["./addon/*"],
      "my-v1-addon/test-support": ["./addon-test-support"],
      "my-v1-addon/test-support/*": ["./addon-test-support/*"],
      "*": ["./types/*"]
    },
    "plugins": [
      {
        "name": "@glint/tsserver-plugin"
      }
    ],
    "rootDir": ".",
    "types": ["@glint/ember-tsc/types", "@types/qunit", "ember-source/types"]
  },
  "include": [
    "addon/**/*",
    "addon-test-support/**/*",
    "tests/**/*",
    "types/**/*"
  ],
  "glint": {
    "additionalSpecialForms": {
      "imports": {
        "ember-truth-helpers": {
          "and": "&&",
          "eq": "===",
          "not": "!",
          "not-eq": "!==",
          "or": "||"
        },
        "ember-truth-helpers/helpers/and": {
          "default": "&&"
        },
        "ember-truth-helpers/helpers/eq": {
          "default": "==="
        },
        "ember-truth-helpers/helpers/not": {
          "default": "!"
        },
        "ember-truth-helpers/helpers/not-eq": {
          "default": "!=="
        },
        "ember-truth-helpers/helpers/or": {
          "default": "||"
        }
      }
    }
  }
}
