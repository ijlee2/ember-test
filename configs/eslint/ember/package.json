{
  "name": "@shared-configs/eslint-config-ember",
  "version": "0.0.0",
  "private": true,
  "description": "Configuration for eslint (Ember)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/ember-testem.git"
  },
  "author": "Isaac J. Lee",
  "type": "module",
  "exports": {
    "./v1-addon": "./src/v1-addon.ts",
    "./v1-app": "./src/v1-app.ts",
    "./v2-addon": "./src/v2-addon.ts",
    "./v2-app": "./src/v2-app.ts"
  },
  "scripts": {
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit"
  },
  "dependencies": {
    "@ijlee2-frontend-configs/eslint-config-ember": "^4.8.1"
  },
  "devDependencies": {
    "@shared-configs/eslint-config-node": "workspace:*",
    "@shared-configs/prettier": "workspace:*",
    "@shared-configs/typescript": "workspace:*",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.13.0",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": false
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": "22.* || >= 24"
  }
}
