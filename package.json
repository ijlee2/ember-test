{
  "name": "ember-test",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for ember-test",
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/ember-test.git"
  },
  "license": "MIT",
  "author": "Isaac J. Lee",
  "type": "module",
  "scripts": {
    "build": "pnpm build:packages",
    "build:packages": "pnpm --filter my-v2-addon build",
    "format": "pnpm --filter \"*\" format",
    "lint": "pnpm --filter \"*\" lint && pnpm lint:package-json",
    "lint:fix": "pnpm --filter \"*\" lint:fix && pnpm lint:package-json:fix",
    "lint:package-json": "pnpm lint:package-json:fix --check",
    "lint:package-json:fix": "sort-package-json \"**/package.json\" --ignore \"**/{blueprints,dist,dist-for-testing,node_modules,tests,tmp}/**\"",
    "prepare": "pnpm build:packages",
    "release:prepare": "changeset version; update-workspace-root-version",
    "release:publish": "pnpm build:packages && changeset publish",
    "test": "pnpm --filter \"./tests/**\" test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@ijlee2-frontend-configs/changesets": "^3.0.2",
    "sort-package-json": "^4.0.0",
    "update-workspace-root-version": "^3.0.6"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": "22.* || >= 24",
    "pnpm": ">= 11"
  }
}
